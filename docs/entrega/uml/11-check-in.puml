@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #172841
skinparam ArrowColor #35506F
skinparam actorBorderColor #35506F
skinparam sequenceParticipantBackgroundColor #EFF4FA
skinparam sequenceParticipantBorderColor #55718D
skinparam sequenceLifeLineBorderColor #8295A9
skinparam classBackgroundColor #F4F7FB
skinparam classBorderColor #55718D
skinparam stateBackgroundColor #EFF4FA
skinparam stateBorderColor #55718D
skinparam usecaseBackgroundColor #EFF4FA
skinparam usecaseBorderColor #55718D
skinparam noteBackgroundColor #F4F8F5
skinparam noteBorderColor #739187
actor "Receptionist" as U
participant EstanciaController as C
participant EstanciaService as S
participant "Repositories" as R
database MySQL as DB
U -> C : POST /check-in-check-out/{id}/check-in
C -> S : registrarEntrada(id)
group READ_COMMITTED transaction
  S -> R : Lock reservation, room and type as needed
  R -> DB : Read state, occupancy and capacity
  alt Confirmed within the arrival window and room is free
    S -> S : Record local time and set EN_CURSO
    R -> DB : Persist timestamp and OCUPADA in one commit
  else Invalid state, interval or room occupancy
    S --> C : Conflict with no partial write
  end
end
C --> U : Redirect with success or return an error
@enduml
