@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #172841
skinparam ArrowColor #35506F
skinparam actorBorderColor #35506F
skinparam sequenceParticipantBackgroundColor #EFF4FA
skinparam sequenceParticipantBorderColor #55718D
skinparam sequenceLifeLineBorderColor #8295A9
skinparam classBackgroundColor #F4F7FB
skinparam classBorderColor #55718D
skinparam stateBackgroundColor #EFF4FA
skinparam stateBorderColor #55718D
skinparam usecaseBackgroundColor #EFF4FA
skinparam usecaseBorderColor #55718D
skinparam noteBackgroundColor #F4F8F5
skinparam noteBorderColor #739187
actor "User" as U
participant "Spring Security" as F
participant CuentasUserDetailsService as S
participant CuentaRepository as R
database MySQL as DB
U -> F : POST /login with correo and password
F -> S : loadUserByUsername(correo)
S -> R : findByCorreo(normalized email)
R -> DB : Read cuenta and linked owner
DB --> S : Hash and role source
S --> F : UserDetails for an active account
F -> F : Verify BCrypt and handle session
alt Valid credentials
  F --> U : Redirect to requested page or /panel
else Invalid credentials
  F --> U : Redirect to /login?error
end
@enduml
