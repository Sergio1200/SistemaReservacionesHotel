@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #172841
skinparam ArrowColor #35506F
skinparam actorBorderColor #35506F
skinparam sequenceParticipantBackgroundColor #EFF4FA
skinparam sequenceParticipantBorderColor #55718D
skinparam sequenceLifeLineBorderColor #8295A9
skinparam classBackgroundColor #F4F7FB
skinparam classBorderColor #55718D
skinparam stateBackgroundColor #EFF4FA
skinparam stateBorderColor #55718D
skinparam usecaseBackgroundColor #EFF4FA
skinparam usecaseBorderColor #55718D
skinparam noteBackgroundColor #F4F8F5
skinparam noteBorderColor #739187
hide empty description
[*] --> PENDIENTE : create reservation
PENDIENTE --> CONFIRMADA : approved total covers cost
CONFIRMADA --> PENDIENTE : revised cost leaves a balance
PENDIENTE --> CANCELADA : cancel before check-in
CONFIRMADA --> CANCELADA : cancel before check-in
CONFIRMADA --> EN_CURSO : valid check-in
EN_CURSO --> FINALIZADA : valid check-out
CANCELADA --> [*]
FINALIZADA --> [*]
note right of CONFIRMADA
  A reduced cost may confirm a pending
  reservation when approved payments
  already cover the revised total.
end note
@enduml
