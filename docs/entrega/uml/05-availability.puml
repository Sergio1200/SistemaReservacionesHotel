@startuml
skinparam dpi 180
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #172841
skinparam ArrowColor #35506F
skinparam actorBorderColor #35506F
skinparam sequenceParticipantBackgroundColor #EFF4FA
skinparam sequenceParticipantBorderColor #55718D
skinparam sequenceLifeLineBorderColor #8295A9
skinparam classBackgroundColor #F4F7FB
skinparam classBorderColor #55718D
skinparam stateBackgroundColor #EFF4FA
skinparam stateBorderColor #55718D
skinparam usecaseBackgroundColor #EFF4FA
skinparam usecaseBorderColor #55718D
skinparam noteBackgroundColor #F4F8F5
skinparam noteBorderColor #739187
actor "Visitor" as U
participant DisponibilidadController as C
participant DisponibilidadService as S
participant HabitacionRepository as R
database MySQL as DB
U -> C : GET /disponibilidad with dates and guest count
C -> S : consultar(entrada, salida, huespedes)
S -> S : Validate dates using the hotel clock
S -> R : buscarDisponibles(...)
R -> DB : Filter capacity, overlapping reservations and occupancy
DB --> S : Available rooms and nightly prices
S --> C : Estimates based on nights and price
C --> U : Render results or validation messages
@enduml
